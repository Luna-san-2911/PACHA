#!/bin/bash -l
#SBATCH -J whatshap_phase
#SBATCH --array=0-35%36
#SBATCH --output=whatshap_phase-%A_%a.output
#SBATCH --error=whatshap_phase-%A_%a.error
#SBATCH -t 72:00:00
#SBATCH --partition=bmh
#SBATCH --mail-type=ALL
#SBATCH --mail-user=plunarodriguez@ucdavis.edu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

set -euo pipefail
echo "Running on host: $(hostname)"
echo "Starting at: $(date)"

# ── Paths ─────────────────────────────────────────────────────────────────────
BASE=/group/gmonroegrp2/chaehee/Pablo/pangenome
GAM_DIR=$BASE/02_alignment_atl_int_pangenome/filtered
# Use filtered VCFs from the refvcf directory
VCF_DIR=$BASE/03_variant_calling_atl_int_pangenome_gfa/refvcf/filtered
GBZ=$BASE/02_alignment_atl_int_pangenome/atl_int_pangenome.giraffe.gbz
# The reference FASTA resides under the pangenie directory, not pangenome
REF=/group/gmonroegrp2/chaehee/Pablo/pangenie/01_build_pangenome_vcf/input/Patl.hap2.Chr01_15.fa
# New output base directory for whatshap results
OUT_DIR=$BASE/04_whatshap_gfa_v2
BAM_DIR=$OUT_DIR/gam_to_bam_unfiltered
PHASED_DIR=$OUT_DIR/phased_vcf_unfiltered
STATS_DIR=$OUT_DIR/stats_unfiltered

mkdir -p "$BAM_DIR" "$PHASED_DIR" "$STATS_DIR"

# ── Build sample list from GAM files ─────────────────────────────────────────
shopt -s nullglob
gam_files=("$GAM_DIR"/*_aln.filtered.gam)

if (( SLURM_ARRAY_TASK_ID >= ${#gam_files[@]} )); then
    echo "SLURM_ARRAY_TASK_ID=${SLURM_ARRAY_TASK_ID} is out of range (0-$((${#gam_files[@]} - 1)))." >&2
    exit 1
fi

gam_file=${gam_files[$SLURM_ARRAY_TASK_ID]}
sample=$(basename "$gam_file" _aln.filtered.gam)

echo "Processing sample: $sample"
echo "  GAM:  $gam_file"

# ── Input VCF check ───────────────────────────────────────────────────────────
# Filtered VCFs have the .filtered.vcf.gz suffix
VCF_IN=$VCF_DIR/${sample}.filtered.vcf.gz
if [[ ! -s "$VCF_IN" ]]; then
    echo "ERROR: Expected VCF not found: $VCF_IN" >&2
    exit 1
fi

source /home/plunarod/miniconda3/bin/activate

# ── Step 1: vg surject GAM → BAM ─────────────────────────────────────────────
# Note: input GAMs are already quality-filtered (vg filter -r 0.90 -q 20 -m 1)
# from the alignment step (02_alignment_atl_int_pangenome/filtered/).
# Therefore only coordinate sorting and indexing are needed here;
# no additional BAM filtering is applied.
BAM=$BAM_DIR/${sample}.sorted.bam

conda activate pangenome

if [[ -s "$BAM" && -s "${BAM}.bai" ]]; then
    echo "Step 1 - Skipping vg surject: $BAM already exists."
else
    echo "Step 1 - Running vg surject for ${sample}..."
    vg surject \
        -x "$GBZ" \
        -b \
        -N "$sample" \
        -t 64 \
        "$gam_file" \
    | samtools sort -@ 64 -o "$BAM.tmp"
    mv "$BAM.tmp" "$BAM"
    samtools index "$BAM"
    echo "Step 1 - BAM created: $BAM"
fi

conda deactivate

# ── Step 2: Index input VCF ───────────────────────────────────────────────────
conda activate vcf

TBI=$VCF_IN.tbi

if [[ -s "$TBI" ]]; then
    echo "Step 2 - Skipping tabix: $TBI already exists."
else
    echo "Step 2 - Indexing input VCF for ${sample}..."
    tabix -p vcf "$VCF_IN"
    echo "Step 2 - Index created: $TBI"
fi

conda deactivate

# ── Step 3: WhatsHap phase ────────────────────────────────────────────────────
conda activate whatshap-env

PHASED_VCF=$PHASED_DIR/${sample}.phased.vcf.gz
PHASE_LOG=$PHASED_DIR/${sample}.phase.log

# Re‑run phase if the file is missing or empty (e.g., previous pre‑empted run left a truncated file)
if [[ -s "$PHASED_VCF" && $(stat -c%s "$PHASED_VCF") -gt 0 ]]; then
    echo "Step 3 - Skipping WhatsHap phase: $PHASED_VCF already exists and is non‑empty."
else
    echo "Step 3 - Running WhatsHap phase for ${sample}..."
    whatshap phase \
        --output "$PHASED_VCF" \
        --reference "$REF" \
        --sample "$sample" \
        --ignore-read-groups \
        "$VCF_IN" \
        "$BAM" \
        > "$PHASE_LOG" 2>&1 || { echo "ERROR: WhatsHap failed for ${sample}. See ${PHASE_LOG}" >&2; exit 1; }
    # Index the resulting VCF (only if it was successfully created)
    if [[ -s "$PHASED_VCF" && $(stat -c%s "$PHASED_VCF") -gt 0 ]]; then
        tabix -p vcf "$PHASED_VCF"
        echo "Step 3 - Phased VCF created: $PHASED_VCF"
    else
        echo "ERROR: Phased VCF $PHASED_VCF is empty after WhatsHap phase." >&2
        exit 1
    fi
fi

# ── Step 4: WhatsHap stats ────────────────────────────────────────────────────
STATS=$STATS_DIR/${sample}.phase_stats.tsv

# Only run stats if a valid phased VCF is present
if [[ -s "$STATS" ]]; then
    echo "Step 4 - Skipping WhatsHap stats: $STATS already exists."
else
    if [[ -s "$PHASED_VCF" && $(stat -c%s "$PHASED_VCF") -gt 0 ]]; then
        echo "Step 4 - Running WhatsHap stats for ${sample}..."
        whatshap stats \
            --tsv "$STATS" \
            "$PHASED_VCF" || { echo "ERROR: WhatsHap stats failed for ${sample}." >&2; exit 1; }
        echo "Step 4 - Phase stats written: $STATS"
    else
        echo "ERROR: Cannot run WhatsHap stats because phased VCF is missing or empty." >&2
        exit 1
    fi
fi

conda deactivate
echo "Finished at: $(date)"
