#!/bin/bash -l
#SBATCH -J infer_genomes_pggb
#SBATCH --output=infer_genomes_pggb-%j.output
#SBATCH --error=infer_genomes_pggb-%j.error
#SBATCH -t 20:00:00
#SBATCH --partition=bmh
#SBATCH --mail-type=ALL
#SBATCH --mail-user=plunarodriguez@ucdavis.edu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G

#Be aware that I am swaping haplotype 2 with 1 as the 1 resulted to be from atlantica and 2 from integerrima

set -euo pipefail
echo "Running on host: $(hostname)"
echo "Starting at: $(date)"

# ── Paths ─────────────────────────────────────────────────────────────────────
REF=/group/gmonroegrp2/chaehee/Pablo/pangenie/01_build_pangenome_vcf/input/Patl.hap2.Chr01_15.fa
# Phased VCFs produced by the whatshap script (04_whatshap_gfa_v2)
VCF_DIR=/group/gmonroegrp2/chaehee/Pablo/pangenome/04_whatshap_gfa_v2/phased_vcf_unfiltered
# New output directory for inferred genomes
OUT_DIR=/group/gmonroegrp2/chaehee/Pablo/pangenome/05_infered_genomes_v2
REPORT_FILE=$OUT_DIR/phased_variant_report.tsv

mkdir -p "$OUT_DIR"

if [[ ! -s "$REPORT_FILE" ]]; then
    printf "sample\toriginal_variants\tphased_only_variants\tphased_fraction\n" > "$REPORT_FILE"
fi

source /home/plunarod/miniconda3/bin/activate
conda activate pangenome

bcftools_nowarn() {
    bcftools "$@" 2> >(grep -Fv '[W::bcf_hdr_check_sanity] GP should be declared as Number=G' >&2)
}

shopt -s nullglob
vcf_files=("$VCF_DIR"/*.phased.vcf.gz)

for vcf_file in "${vcf_files[@]}"; do

    sample=$(basename "$vcf_file" .phased.vcf.gz)
    echo "Processing sample: $sample"

    mapfile -t vcf_samples < <(bcftools_nowarn query -l "$vcf_file")
    if [[ ${#vcf_samples[@]} -eq 0 ]]; then
        echo "ERROR: No samples found in VCF: $vcf_file" >&2
        exit 1
    fi

    if printf '%s\n' "${vcf_samples[@]}" | grep -Fxq "$sample"; then
        consensus_sample="$sample"
    elif [[ ${#vcf_samples[@]} -eq 1 ]]; then
        consensus_sample="${vcf_samples[0]}"
        echo "WARNING: VCF sample name differs from file name; using sample: $consensus_sample"
    else
        echo "ERROR: Multiple samples in $vcf_file and file-derived sample '$sample' not found in header." >&2
        exit 1
    fi

    # ── Step 1: Index phased VCF ──────────────────────────────────────────────
    TBI=${vcf_file}.tbi

    if [[ -s "$TBI" ]]; then
        echo "Step 1 - Skipping tabix: $TBI already exists."
    else
        echo "Step 1 - Indexing phased VCF for ${sample}..."
        tabix -p vcf "$vcf_file"
        echo "Step 1 - Index created: $TBI"
    fi

    # ── Step 2: Filter to variants with phased genotypes ─────────────────────
    PHASED_VCF=$OUT_DIR/${sample}.phased_only.vcf.gz
    PHASED_TBI=${PHASED_VCF}.tbi

    if [[ -s "$PHASED_VCF" && -s "$PHASED_TBI" ]]; then
        echo "Step 2 - Skipping phased-only filter: $PHASED_VCF already exists."
    else
        echo "Step 2 - Filtering phased variants for ${sample}..."
        PHASED_TMP=${PHASED_VCF%.gz}
        bcftools_nowarn view -h -s "$consensus_sample" "$vcf_file" > "$PHASED_TMP"
        bcftools_nowarn view -H -s "$consensus_sample" "$vcf_file" \
        | awk -F'\t' 'BEGIN{OFS="\t"} { split($10,fmt,":"); if (fmt[1] ~ /\|/) print }' \
        >> "$PHASED_TMP"
        bgzip -f "$PHASED_TMP"
        tabix -p vcf "$PHASED_VCF"
        echo "Step 2 - Phased-only VCF created: $PHASED_VCF"
    fi

    orig_n=$(zgrep -vc '^#' "$vcf_file")
    phased_n=$(zgrep -vc '^#' "$PHASED_VCF")
    if [[ "$phased_n" -eq 0 ]]; then
        echo "ERROR: No phased variants found for sample ${sample} in ${vcf_file}." >&2
        exit 1
    fi
    phased_fraction=$(awk -v p="$phased_n" -v o="$orig_n" 'BEGIN { if (o==0) print "0"; else printf "%.6f", p/o }')
    printf "%s\t%s\t%s\t%s\n" "$sample" "$orig_n" "$phased_n" "$phased_fraction" >> "$REPORT_FILE"
    echo "Step 2 - Variant report: original=${orig_n}, phased_only=${phased_n}, fraction=${phased_fraction}"

    # ── Step 3: bcftools consensus haplotype 1 ────────────────────────────────
    HAP1=$OUT_DIR/${sample}_pggb_hap1.fasta.gz

    if [[ -s "$HAP1" ]]; then
        echo "Step 3 - Skipping haplotype 1: $HAP1 already exists."
    else
        echo "Step 3 - Inferring haplotype 1 for ${sample}..."
        bcftools_nowarn consensus -s "$consensus_sample" -H 1 -f "$REF" "$PHASED_VCF" \
        | bgzip -c > "$HAP1"
        echo "Step 3 - Haplotype 1 created: $HAP1"
    fi

    # ── Step 4: bcftools consensus haplotype 2 ────────────────────────────────
    HAP2=$OUT_DIR/${sample}_pggb_hap2.fasta.gz

    if [[ -s "$HAP2" ]]; then
        echo "Step 4 - Skipping haplotype 2: $HAP2 already exists."
    else
        echo "Step 4 - Inferring haplotype 2 for ${sample}..."
        bcftools_nowarn consensus -s "$consensus_sample" -H 2 -f "$REF" "$PHASED_VCF" \
        | bgzip -c > "$HAP2"
        echo "Step 4 - Haplotype 2 created: $HAP2"
    fi

    # ── Step 5: Remove temporary phased-only VCF files ───────────────────────
    if [[ -s "$HAP1" && -s "$HAP2" ]]; then
        rm -f "$PHASED_VCF" "$PHASED_TBI"
        echo "Step 5 - Removed temporary files: $PHASED_VCF and $PHASED_TBI"
    else
        echo "Step 5 - Skipping cleanup because one or more haplotype outputs are missing."
    fi

    echo "Done with sample: $sample"
    echo "──────────────────────────────────────────"

done

conda deactivate
echo "Finished at: $(date)"
