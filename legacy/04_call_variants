#!/bin/bash -l
#SBATCH -J vg_call_refvcf
#SBATCH --array=0-35%6
#SBATCH --output=vg_call_refvcf-%A_%a.output
#SBATCH --error=vg_call_refvcf-%A_%a.error
#SBATCH -t 72:00:00
#SBATCH --partition=low
#SBATCH --account=publicgrp
#SBATCH --mail-type=ALL
#SBATCH --mail-user=plunarodriguez@ucdavis.edu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

set -euo pipefail

echo "Running on host: $(hostname)"
echo "Starting at: $(date)"
echo "SLURM array task ID: ${SLURM_ARRAY_TASK_ID:?SLURM array job required}"

# =============================================================================
# Paths: ALL inputs correspond to the FASTA+VCF-built graph.
# =============================================================================

BASE=/group/gmonroegrp2/chaehee/Pablo/pangenome

ALIGN_DIR="$BASE/02_alignment_to_gfa_autoindex/refvcf"
CALL_DIR="$BASE/03_variant_calling_atl_int_pangenome_gfa/refvcf"

GBZ_DIR="$BASE/01_atl_int_pangenome_per_chr/odgi_squeeze/vg_autoindex"
GBZ="$GBZ_DIR/atl_int_chr_pangenome_refvcf.giraffe.gbz"

PACK_DIR="$ALIGN_DIR/filtered"
VCF_DIR="$CALL_DIR/vcf"
FILTERED_DIR="$CALL_DIR/filtered"

THREADS=64
N_SAMPLES=36

mkdir -p "$VCF_DIR" "$FILTERED_DIR"

has_content() {
    [[ -s "$1" ]]
}

[[ -s "$GBZ" ]] || {
    echo "ERROR: Missing GBZ: $GBZ" >&2
    exit 1
}

[[ -d "$PACK_DIR" ]] || {
    echo "ERROR: Missing pack directory: $PACK_DIR" >&2
    exit 1
}

# =============================================================================
# Identify the pack for the current sample.
# =============================================================================

shopt -s nullglob
SAMPLE_PACKS=("$PACK_DIR"/*.pack)
shopt -u nullglob

if (( ${#SAMPLE_PACKS[@]} != N_SAMPLES )); then

    echo "ERROR: Expected $N_SAMPLES packs in $PACK_DIR; found ${#SAMPLE_PACKS[@]}" >&2

    printf '%s\n' "${SAMPLE_PACKS[@]}" >&2
    exit 1

fi

mapfile -t SAMPLE_PACKS < <(
    printf '%s\n' "${SAMPLE_PACKS[@]}" | sort -V
)

SAMPLE_INDEX="${SLURM_ARRAY_TASK_ID}"

if (( SAMPLE_INDEX < 0 || SAMPLE_INDEX >= N_SAMPLES )); then
    echo "ERROR: Invalid array index: $SAMPLE_INDEX" >&2
    exit 1
fi

SAMPLE_PACK="${SAMPLE_PACKS[$SAMPLE_INDEX]}"
SAMPLE="$(basename "$SAMPLE_PACK" .pack)"

VCF="$VCF_DIR/${SAMPLE}.vcf.gz"

FILTERED_PREFIX="$FILTERED_DIR/${SAMPLE}.filtered"
FILTERED_VCF="${FILTERED_PREFIX}.vcf.gz"
FILTER_LOG="${FILTERED_PREFIX}.filter.log"

[[ -s "$SAMPLE_PACK" ]] || {
    echo "ERROR: Empty pack: $SAMPLE_PACK" >&2
    exit 1
}

echo "Sample:        $SAMPLE"
echo "Graph GBZ:     $GBZ"
echo "Pack:          $SAMPLE_PACK"
echo "Raw VCF:       $VCF"
echo "Filtered VCF:  $FILTERED_VCF"
echo "Threads:       $THREADS"

# =============================================================================
# Temporary files
# =============================================================================

JOB_TAG="${SLURM_JOB_ID:-$$}"

TMP_VCF="$VCF_DIR/.${SAMPLE}.${JOB_TAG}.vcf.gz"
TMP_FILTERED_VCF="$FILTERED_DIR/.${SAMPLE}.${JOB_TAG}.vcf.gz"
VCFTOOLS_PREFIX="$FILTERED_DIR/.${SAMPLE}.${JOB_TAG}.vcftools"

trap 'rm -f -- "$TMP_VCF" "${TMP_VCF}.tbi" "$TMP_FILTERED_VCF" "${TMP_FILTERED_VCF}.tbi" "${VCFTOOLS_PREFIX}.recode.vcf"' EXIT

# =============================================================================
# Step 1: vg call
#
# -k: Use pack generated from this exact GBZ
# -s: Set sample name
# -a: Genotype all snarls, including 0/0 reference calls
#
# Do not add -v with the vg autoindex-generated graph.
# =============================================================================

source /home/plunarod/miniconda3/etc/profile.d/conda.sh
conda activate pangenome

for tool in vg bcftools; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR: Missing $tool in pangenome environment" >&2
        exit 1
    }
done

echo "VG version:"
vg version

if has_content "$VCF"; then

    echo "Raw VCF exists: $VCF"

    if [[ ! -s "${VCF}.tbi" ]]; then
        echo "Creating missing VCF index..."
        bcftools index -f -t "$VCF"
    fi

else

    echo "Calling variants for $SAMPLE"

    vg call \
        "$GBZ" \
        -k "$SAMPLE_PACK" \
        -s "$SAMPLE" \
        -a \
        -t "$THREADS" \
        --progress \
      | bcftools sort \
            -T "$VCF_DIR/.sort_${SAMPLE}_${JOB_TAG}" \
            -Oz \
            -o "$TMP_VCF"

    [[ -s "$TMP_VCF" ]] || {
        echo "ERROR: Empty vg call VCF for $SAMPLE" >&2
        exit 1
    }

    bcftools index -f -t "$TMP_VCF"

    mv "$TMP_VCF" "$VCF"
    mv "${TMP_VCF}.tbi" "${VCF}.tbi"

    echo "Created VCF: $VCF"

fi

# =============================================================================
# Validate raw VCF
# =============================================================================

bcftools view -h "$VCF" > /dev/null

N_RAW="$(bcftools index -n "$VCF")"

echo "Raw VCF records: $N_RAW"

if (( N_RAW == 0 )); then
    echo "ERROR: vg call generated zero records for $SAMPLE" >&2
    exit 1
fi

conda deactivate

# =============================================================================
# Step 2: Filter the VCF
#
# Preserve original filtering thresholds:
#   QUAL >= 20
#   GQ   >= 20
#   DP   >= 5
# =============================================================================

conda activate vcf
module load bcftools

for tool in vcftools bgzip tabix; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR: Missing $tool in vcf environment" >&2
        exit 1
    }
done

if has_content "$FILTERED_VCF"; then

    echo "Filtered VCF already exists: $FILTERED_VCF"

    if [[ ! -s "${FILTERED_VCF}.tbi" ]]; then
        tabix -f -p vcf "$FILTERED_VCF"
    fi

else

    echo "Filtering VCF for $SAMPLE"

    vcftools \
        --gzvcf "$VCF" \
        --minQ 20 \
        --minGQ 20 \
        --minDP 5 \
        --recode \
        --recode-INFO-all \
        --out "$VCFTOOLS_PREFIX" \
        > "$FILTER_LOG" 2>&1

    RECODE_VCF="${VCFTOOLS_PREFIX}.recode.vcf"

    if [[ ! -s "$RECODE_VCF" ]]; then
        echo "ERROR: VCFtools did not produce a VCF for $SAMPLE" >&2
        exit 1
    fi

    bgzip -c "$RECODE_VCF" > "$TMP_FILTERED_VCF"

    [[ -s "$TMP_FILTERED_VCF" ]] || {
        echo "ERROR: Empty filtered VCF for $SAMPLE" >&2
        exit 1
    }

    tabix -f -p vcf "$TMP_FILTERED_VCF"

    mv "$TMP_FILTERED_VCF" "$FILTERED_VCF"
    mv "${TMP_FILTERED_VCF}.tbi" "${FILTERED_VCF}.tbi"

    rm -f "$RECODE_VCF"

    echo "Created filtered VCF: $FILTERED_VCF"

fi

# =============================================================================
# Step 3: Final statistics
# =============================================================================

if command -v bcftools >/dev/null 2>&1; then

    N_FILTERED="$(bcftools index -n "$FILTERED_VCF")"

    echo "Filtered VCF records: $N_FILTERED"

    if (( N_FILTERED == 0 )); then
        echo "WARNING: Zero records remained after filtering for $SAMPLE" >&2
    fi

fi

conda deactivate

echo "Successfully called and filtered sample: $SAMPLE"
echo "Raw VCF:      $VCF"
echo "Filtered VCF: $FILTERED_VCF"
echo "Finished at: $(date)"
