#!/bin/bash -l
#SBATCH -J atl_int_autoindex
#SBATCH --output=atl_int_autoindex-%j.output
#SBATCH --error=atl_int_autoindex-%j.error
#SBATCH -t 48:00:00
#SBATCH --partition=bmh
#SBATCH --mail-type=ALL
#SBATCH --mail-user=plunarodriguez@ucdavis.edu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=256G

set -euo pipefail

echo "Running on host: $(hostname)"
echo "Starting at: $(date)"

source /home/plunarod/miniconda3/etc/profile.d/conda.sh
conda activate pangenome

THREADS="${SLURM_CPUS_PER_TASK:-16}"

base=/group/gmonroegrp2/chaehee/Pablo/pangenome/01_atl_int_pangenome_per_chr

merged="$base/odgi_squeeze"
mkdir -p "$merged"

graph_list="$merged/chr_graphs.txt"
merged_og="$merged/atl_int_chr_pangenome.og"
merged_gfa="$merged/atl_int_chr_pangenome.gfa"
ref_gfa="$merged/atl_int_chr_pangenome.ref.gfa"

index_dir="$merged/vg_autoindex"
mkdir -p "$index_dir"

# New prefix to avoid reusing previous GFA-only indexes.
prefix="$index_dir/atl_int_chr_pangenome_refvcf"

tmp_dir="$index_dir/tmp_refvcf"
mkdir -p "$tmp_dir"

# Original Patl haplotype-2 reference FASTA.
ref_fasta=/group/gmonroegrp2/chaehee/Pablo/pangenie/01_build_pangenome_vcf/input/Patl.hap2.Chr01_15.fa

# Same reference sequence, with headers matching the VCF.
ref_fasta_vg="$merged/Patl.hap2.Chr01_15.for_vg.fa"

# VCF generated by vg deconstruct.
vcf="$index_dir/atl_int_chr_pangenome_refvcf.vcf.gz"

# Verify programs.
for tool in odgi vg bcftools samtools; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR: missing executable: $tool" >&2
        exit 1
    }
done

[[ -s "$ref_fasta" ]] || {
    echo "ERROR: reference FASTA not found: $ref_fasta" >&2
    exit 1
}

echo "ODGI version:"
odgi version

echo "VG version:"
vg version


####
# 1. ODGI squeeze
# Original working chromosome input discovery.
####

if [[ -s "$merged_og" ]]; then

    echo "Merged ODGI already exists. Skipping squeeze."

else

    echo "Preparing chromosome graph list"

    : > "$graph_list"

    shopt -s nullglob

    for chr in {01..15}; do

        graphs=("$base/chr$chr"/*.og)

        if (( ${#graphs[@]} == 0 )); then
            echo "ERROR: no .og files in $base/chr$chr" >&2
            exit 1
        fi

        printf '%s\n' "${graphs[@]}" >> "$graph_list"

    done

    shopt -u nullglob

    echo "Squeezing $(wc -l < "$graph_list") graphs"

    tmp_og="${merged_og}.tmp.${SLURM_JOB_ID:-$$}"
    trap 'rm -f "$tmp_og"' EXIT

    odgi squeeze \
        -f "$graph_list" \
        -o "$tmp_og" \
        -t "$THREADS" \
        -P

    [[ -s "$tmp_og" ]] || {
        echo "ERROR: ODGI squeeze failed" >&2
        exit 1
    }

    mv "$tmp_og" "$merged_og"
    trap - EXIT

fi


####
# 2. Convert ODGI to GFA
####

if [[ -s "$merged_gfa" ]]; then

    echo "GFA already exists. Skipping conversion."

else

    echo "Converting ODGI to GFA"

    tmp_gfa="${merged_gfa}.tmp.${SLURM_JOB_ID:-$$}"
    trap 'rm -f "$tmp_gfa"' EXIT

    odgi view \
        -i "$merged_og" \
        -g \
        -t "$THREADS" \
        > "$tmp_gfa"

    [[ -s "$tmp_gfa" ]] || {
        echo "ERROR: GFA conversion failed" >&2
        exit 1
    }

    mv "$tmp_gfa" "$merged_gfa"
    trap - EXIT

fi


####
# 2.5. Add reference backbone copy for vg
#
# Copy Patl#2# paths to REF#1# paths.
# Original Patl and Pint paths remain unchanged.
####

if [[ -s "$ref_gfa" ]]; then

    echo "Reference-copy GFA already exists: $ref_gfa"

else

    echo "Injecting reference-path copies for vg compatibility"

    tmp_ref_gfa="${ref_gfa}.tmp.${SLURM_JOB_ID:-$$}"
    trap 'rm -f "$tmp_ref_gfa"' EXIT

    awk -F '\t' '
        BEGIN { OFS="\t" }

        $1 == "P" && $2 ~ /^Patl#2#/ {
            print
            orig = $2
            $2 = "REF#1#" substr(orig, length("Patl#2#") + 1)
            print
            next
        }

        { print }

    ' "$merged_gfa" > "$tmp_ref_gfa"

    [[ -s "$tmp_ref_gfa" ]] || {
        echo "ERROR: failed to create reference-copy GFA" >&2
        exit 1
    }

    mv "$tmp_ref_gfa" "$ref_gfa"
    trap - EXIT

fi

merged_gfa_for_vg="$ref_gfa"

echo "Reference path examples in vg-compatible GFA:"

awk -F '\t' '
    $1 == "P" &&
    ($2 ~ /^REF#1#/ || $2 ~ /^Patl#2#/) {
        if (++n <= 10) print
    }
' "$merged_gfa_for_vg"


####
# 3. Inspect GFA paths
####

echo "Checking GFA paths"

awk -F '\t' '
    $1 == "P" { print $2 }
    $1 == "W" { print $2 "#" $3 "#" $4 }
' "$merged_gfa_for_vg" > "$merged/gfa_paths.txt"

# Confirm reference backbone exists for all 15 chromosomes.
for chr in {01..15}; do

    grep -Fxq "REF#1#Chr$chr" "$merged/gfa_paths.txt" || {
        echo "ERROR: missing reference path REF#1#Chr$chr" >&2
        exit 1
    }

done

# P-line haplotype recognition requires vg >= 1.53.0.
if awk -F '\t' '
    $1 == "P" {found=1; exit}
    END {exit !found}
' "$merged_gfa_for_vg"; then

    vg_version=$(vg version 2>&1 |
        grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' |
        awk 'NR == 1 { print; exit }' |
        sed 's/^v//')

    if [[ -z "$vg_version" ]]; then
        echo "ERROR: Could not determine vg version" >&2
        exit 1
    fi

    if [[ "$(printf '%s\n' "1.53.0" "$vg_version" |
        sort -V | head -1)" != "1.53.0" ]]; then

        echo "ERROR: vg >= 1.53.0 required for P-line paths" >&2
        exit 1

    fi

fi


####
# 4. VG deconstruct
#
# Reference paths:
#   REF#1#Chr01 ... REF#1#Chr15
#
# VCF chromosome names:
#   Chr01 ... Chr15
#
# Original Patl and Pint haplotypes provide alternate alleles.
####

# Prepare reference FASTA with chromosome names that match
# the deconstructed VCF. Original FASTA is not modified.

if [[ ! -s "$ref_fasta_vg" ]]; then

    echo "Preparing reference FASTA for vg"

    tmp_ref_fa="${ref_fasta_vg}.tmp.${SLURM_JOB_ID:-$$}"
    trap 'rm -f "$tmp_ref_fa"' EXIT

    awk '
        /^>/ {

            name=$1
            sub(/^>/, "", name)

            if (!match(name, /Chr(0[1-9]|1[0-5])$/)) {
                print "ERROR: unrecognized FASTA header: " name > "/dev/stderr"
                bad=1
                exit 1
            }

            chr=substr(name, RSTART, RLENGTH)

            if (seen[chr]++) {
                print "ERROR: repeated chromosome " chr > "/dev/stderr"
                bad=1
                exit 1
            }

            print ">" chr
            count++
            next
        }

        { print }

        END {
            if (bad || count != 15) {
                print "ERROR: expected 15 reference chromosomes, found " count > "/dev/stderr"
                exit 1
            }
        }

    ' "$ref_fasta" > "$tmp_ref_fa"

    mv "$tmp_ref_fa" "$ref_fasta_vg"
    trap - EXIT

fi

# FASTA index.
if [[ ! -s "${ref_fasta_vg}.fai" ]]; then
    samtools faidx "$ref_fasta_vg"
fi


# -------------------------------------------------------------------------
# Deconstruct GFA into VCF
# -------------------------------------------------------------------------

if [[ -s "$vcf" && -s "${vcf}.csi" ]]; then

    echo "Deconstructed VCF already exists."
    echo "Skipping vg deconstruct."

else

    echo "Starting vg deconstruct"

    tmp_vcf="$tmp_dir/deconstructed.${SLURM_JOB_ID:-$$}.vcf.gz"
    trap 'rm -f "$tmp_vcf" "${tmp_vcf}.csi"' EXIT

    vg deconstruct \
        -C \
        -P 'REF#1#' \
        -t "$THREADS" \
        "$merged_gfa_for_vg" \
        | bcftools sort \
            -T "$tmp_dir/bcftools_sort" \
            -Oz \
            -o "$tmp_vcf"

    [[ -s "$tmp_vcf" ]] || {
        echo "ERROR: vg deconstruct produced an empty VCF" >&2
        exit 1
    }

    # Index VCF.
    bcftools index \
        -f \
        -c \
        "$tmp_vcf"

    mv "$tmp_vcf" "$vcf"
    mv "${tmp_vcf}.csi" "${vcf}.csi"

    trap - EXIT

    echo "VG deconstruct finished"

fi


# -------------------------------------------------------------------------
# Verify VCF before rebuilding the graph
# -------------------------------------------------------------------------

echo "Checking deconstructed VCF"

bcftools query -l "$vcf" > "$tmp_dir/vcf_samples.txt"

echo "VCF samples:"
cat "$tmp_dir/vcf_samples.txt"

# Confirm Patl and Pint were retained.
for sample in Patl Pint; do

    grep -Fxq "$sample" "$tmp_dir/vcf_samples.txt" || {
        echo "ERROR: sample $sample absent from VCF" >&2
        exit 1
    }

done

n_variants=$(bcftools index -n "$vcf")

if (( n_variants <= 0 )); then
    echo "ERROR: no variants in deconstructed VCF" >&2
    exit 1
fi

echo "Number of deconstructed VCF records: $n_variants"

# Check chromosome naming.
bcftools index -s "$vcf" > "$tmp_dir/vcf_contigs.txt"

awk -F '\t' '
    $1 !~ /^Chr(0[1-9]|1[0-5])$/ {
        print "ERROR: unexpected VCF chromosome: " $1 > "/dev/stderr"
        bad=1
    }
    END { exit bad ? 1 : 0 }
' "$tmp_dir/vcf_contigs.txt"

# Validate that REF alleles agree with the supplied
# Patl haplotype-2 FASTA.
echo "Validating VCF REF alleles against reference FASTA"

bcftools norm \
    -f "$ref_fasta_vg" \
    -c e \
    -Ou \
    "$vcf" \
    > /dev/null

echo "VCF validation completed"


####
# 5. VG autoindex
#
# NEW: build indexes from FASTA + VCF.
# Do not use --gfa here.
####

gbz="${prefix}.giraffe.gbz"
dist="${prefix}.dist"

# Support different minimizer filenames.
index_complete=false

if [[ -s "$gbz" && -s "$dist" ]]; then

    for min_file in "${prefix}"*.min; do

        if [[ -s "$min_file" ]]; then
            index_complete=true
            break
        fi

    done

fi

if [[ "$index_complete" == true ]]; then

    echo "FASTA+VCF Giraffe indexes already exist."
    echo "Skipping autoindex."

else

    echo "Starting VG autoindex from FASTA + VCF"

    # Select workflow according to vg version.
    if vg autoindex --help 2>&1 |
       grep -q 'sr-giraffe'; then

        workflow="sr-giraffe"

    else

        workflow="giraffe"

    fi

    echo "Workflow: $workflow"
    echo "FASTA: $ref_fasta_vg"
    echo "VCF:   $vcf"

    vg autoindex \
        --workflow "$workflow" \
        --ref-fasta "$ref_fasta_vg" \
        --vcf "$vcf" \
        --prefix "$prefix" \
        --threads "$THREADS" \
        --tmp-dir "$tmp_dir"

    echo "Autoindex finished"

fi


####
# 6. Verify output
####

echo "Checking generated indexes"

[[ -s "$gbz" ]] || {
    echo "ERROR: Missing GBZ: $gbz" >&2
    exit 1
}

[[ -s "$dist" ]] || {
    echo "ERROR: Missing distance index: $dist" >&2
    exit 1
}

min_ok=false

for min_file in "${prefix}"*.min; do

    if [[ -s "$min_file" ]]; then
        min_ok=true
        break
    fi

done

if [[ "$min_ok" != true ]]; then
    echo "ERROR: Missing minimizer index" >&2
    exit 1
fi

# Current versions may generate zipcode-aware minimizer indexes.
if [[ -s "${prefix}.shortread.withzip.min" &&
      ! -s "${prefix}.shortread.zipcodes" ]]; then

    echo "ERROR: Missing zipcode data for minimizer index" >&2
    exit 1

fi

echo "Generated files:"
ls -lh "${prefix}"*

echo "VCF: $vcf"
echo "Reference FASTA: $ref_fasta_vg"
echo "Finished at: $(date)"

conda deactivate
